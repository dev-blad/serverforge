# ─── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=
# Application (client) ID from the General Information page
DISCORD_CLIENT_ID=
# Optional TEST MODE: all commands appear instantly in this server only (no global commands).
# Remove it when you start selling so /setup works in every server.
DEV_GUILD_ID=

# ─── Seller / owner ─────────────────────────────────────────────────────────
# Your Discord user ID. Owner-only commands (/keys, /forge capture) only work for this user…
OWNER_USER_ID=
# …and only inside this guild (your private admin server).
ADMIN_GUILD_ID=

# ─── Licensing ──────────────────────────────────────────────────────────────
# Secret used to HMAC license keys before storing them. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change this after selling keys — existing keys would stop validating.
LICENSE_PEPPER=

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=file:./data/serverforge.db

# ─── Runtime ────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Set to "true" for human-readable logs in development
LOG_PRETTY=false
# Directory containing template YAML files
TEMPLATES_DIR=./templates
# Failed key attempts allowed per window before a user / guild is throttled
KEY_ATTEMPTS_PER_USER=5
KEY_ATTEMPTS_PER_GUILD=15
KEY_ATTEMPT_WINDOW_SECONDS=900
# Support link shown in help and DMs (optional)
SUPPORT_URL=
# ─── TixBot (optional) ──────────────────────────────────────────────────────
# Lets templates with the `tixbot` module set TixBot up automatically when it joins.
# URL of the TixBot bot API, e.g. https://tixbot-production.up.railway.app
TIXBOT_API_URL=
# The TixBot bot's BOT_API_SECRET (same value as on the TixBot service)
TIXBOT_API_KEY=
# Register slash commands automatically when the bot starts (set to false to manage manually)
AUTO_REGISTER_COMMANDS=true
