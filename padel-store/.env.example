# ─────────────────────────────────────────────────────────────────────────────
# Courtline Padel — environment variables
# Copy to `.env` for local development. On Vercel, add these under
# Project → Settings → Environment Variables (Production + Preview).
# Every integration is OPTIONAL: when its keys are missing the store falls back
# to a safe local stub so the full order flow can still be demoed.
# NEVER commit real secrets. Variables starting NEXT_PUBLIC_ are sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
# Postgres connection string. Supabase: Project Settings → Database → Connection
# string → "Transaction pooler" (port 6543, add ?pgbouncer=true). Neon / Vercel
# Postgres work too.
DATABASE_URL="postgresql://padel:padel@localhost:5432/padel"
# Direct (non-pooled) connection used by `prisma migrate`. Supabase: "Session" or
# direct connection (port 5432). Locally, same as DATABASE_URL.
DIRECT_URL="postgresql://padel:padel@localhost:5432/padel"

# Public URL of the site, no trailing slash (used in emails, sitemap, Stripe return URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js secret — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Needed when not running on Vercel (e.g. `next start` locally / other hosts).
AUTH_TRUST_HOST=true

# Comma-separated emails that are automatically given the ADMIN role on sign-up/sign-in.
ADMIN_EMAILS="you@yourdomain.co.uk"

# Protects /api/cron/* (Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically).
CRON_SECRET="replace-me-with-a-long-random-string"

# Optional: salt for the cookieless visitor hash (defaults to AUTH_SECRET).
ANALYTICS_SALT=""

# Only used by `npm run db:seed`: password for the seeded admin (default: CourtlineAdmin!2026).
SEED_ADMIN_PASSWORD=""

# ── Business details (shown in footer, emails, invoices, legal pages) ─────────
NEXT_PUBLIC_STORE_NAME="Courtline Padel"
NEXT_PUBLIC_COMPANY_NAME="Courtline Padel Ltd"
NEXT_PUBLIC_COMPANY_NUMBER="00000000"
NEXT_PUBLIC_VAT_NUMBER="GB000000000"
NEXT_PUBLIC_BUSINESS_ADDRESS="Unit 1, Example Business Park, Manchester, M1 1AA"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@yourdomain.co.uk"
NEXT_PUBLIC_SUPPORT_PHONE=""
# Free delivery threshold in pence (default 5000 = £50).
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=5000

# ── Stripe (payments) ─────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use TEST keys (sk_test_/pk_test_) until launch.
# If unset, checkout runs in "simulated payment" demo mode.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Dashboard → Developers → Webhooks → endpoint https://YOUR_DOMAIN/api/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
# Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints a whsec_… secret.
STRIPE_WEBHOOK_SECRET=""
# Set to true in production to guarantee simulated payments can never be used.
DISABLE_SIMULATED_PAYMENTS=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
# resend.com → API Keys. Verify your sending domain first (Domains → Add).
# If unset, emails are recorded in Admin → Email outbox instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="Courtline Padel <orders@yourdomain.co.uk>"
EMAIL_REPLY_TO="hello@yourdomain.co.uk"
# Where new-order alerts, chat fallbacks and the daily packing summary go.
OWNER_NOTIFICATION_EMAIL=""

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Shipping labels ───────────────────────────────────────────────────────────
# stub (default, generates a DEMO PDF label) | royalmail | shipstation
SHIPPING_PROVIDER="stub"
# Create a label automatically as soon as an order is paid (default true).
FULFILMENT_AUTO_LABELS=true
# Ship-from address (used by ShipStation and on labels).
SHIP_FROM_NAME="Courtline Padel Ltd"
SHIP_FROM_LINE1="Unit 1, Example Business Park"
SHIP_FROM_CITY="Manchester"
SHIP_FROM_POSTCODE="M1 1AA"
SHIP_FROM_PHONE=""
SHIP_FROM_EMAIL=""

# Royal Mail Click & Drop — parcel.royalmail.com → Settings → Integrations → Click & Drop API.
# Label generation via API must be enabled on your account (not available on OLP accounts).
ROYALMAIL_API_KEY=""
# Service codes from your Click & Drop account (Settings → Shipping services).
ROYALMAIL_SERVICE_TRACKED24="TOLP24"
ROYALMAIL_SERVICE_TRACKED48="TOLP48"

# ShipStation — Settings → Account → API Settings (v1 API key/secret).
SHIPSTATION_API_KEY=""
SHIPSTATION_API_SECRET=""
# Carrier/service codes as shown by GET /carriers and /carriers/listservices for your account.
SHIPSTATION_CARRIER_ROYALMAIL="royal_mail"
SHIPSTATION_CARRIER_EVRI="evri"
SHIPSTATION_SERVICE_TRACKED24="rm_tracked_24"
SHIPSTATION_SERVICE_TRACKED48="rm_tracked_48"
SHIPSTATION_SERVICE_EVRI="evri_standard"
# Keep true until you're ready to buy real postage.
SHIPSTATION_TEST_LABELS=true

# ── PrintNode (automatic label printing) ──────────────────────────────────────
# printnode.com → install the PrintNode client on the computer connected to your
# label printer → Account → API Keys. Printer IDs are shown in the PrintNode app.
PRINTNODE_API_KEY=""
PRINTNODE_PRINTER_ID=""
# Optional second printer (A4) for packing slips; defaults to PRINTNODE_PRINTER_ID.
PRINTNODE_SLIP_PRINTER_ID=""
# Send label + packing slip to the printer automatically after payment (default true).
FULFILMENT_AUTO_PRINT=true
# Also print all packing slips with the morning summary cron.
PRINT_DAILY_SLIPS=false

# ── Live chat → WhatsApp (Twilio) ─────────────────────────────────────────────
# internal (built-in widget + WhatsApp relay, default) | crisp | tawk
NEXT_PUBLIC_CHAT_PROVIDER="internal"
# console.twilio.com → Messaging → Senders → WhatsApp senders (or the WhatsApp Sandbox for testing).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Your Twilio WhatsApp-enabled number, e.g. +447700900123
TWILIO_WHATSAPP_FROM=""
# YOUR personal WhatsApp number that receives chats, e.g. +447700900456
OWNER_WHATSAPP_TO=""
# Optional: approved template (Content SID HX…) with one {{1}} variable, used so
# notifications still arrive outside WhatsApp's 24-hour session window.
TWILIO_WHATSAPP_TEMPLATE_SID=""
# Optional: exact public URL configured in Twilio for incoming messages (defaults to
# NEXT_PUBLIC_SITE_URL + /api/chat/whatsapp). Must match exactly for signature checks.
TWILIO_WEBHOOK_URL=""

# Fallback third-party chat widgets (loaded only after "functional" cookie consent).
NEXT_PUBLIC_CRISP_WEBSITE_ID=""
NEXT_PUBLIC_TAWK_PROPERTY_ID=""   # format: propertyId/widgetId

# ── Analytics (loaded only after "analytics" cookie consent) ──────────────────
# Vercel Web Analytics: enable in Vercel → Project → Analytics. Set false to disable.
NEXT_PUBLIC_VERCEL_ANALYTICS=true
# Plausible: your site domain as registered at plausible.io (leave blank to disable).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ── Tests ─────────────────────────────────────────────────────────────────────
# Separate database for `npm test` — MUST end in _test (tables are truncated).
TEST_DATABASE_URL="postgresql://padel:padel@localhost:5432/padel_test"
